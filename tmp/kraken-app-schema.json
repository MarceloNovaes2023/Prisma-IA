"CREATE TABLE IF NOT EXISTS leads (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT NOT NULL,\n  phone TEXT NOT NULL UNIQUE,\n  email TEXT,\n  vertical TEXT NOT NULL,\n  stage TEXT NOT NULL,\n  score INTEGER NOT NULL DEFAULT 0,\n  source TEXT NOT NULL,\n  tags TEXT NOT NULL DEFAULT '',\n  value REAL NOT NULL DEFAULT 0,\n  owner TEXT NOT NULL,\n  city TEXT,\n  answers TEXT NOT NULL DEFAULT '{}',\n  ai_mode TEXT NOT NULL DEFAULT 'copilot',\n  notes TEXT,\n  opted_in INTEGER NOT NULL DEFAULT 1,\n  created_at TEXT NOT NULL,\n  last_inbound_at TEXT,\n  last_outbound_at TEXT\n);\nCREATE TABLE IF NOT EXISTS messages (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  lead_id INTEGER NOT NULL REFERENCES leads(id) ON DELETE CASCADE,\n  direction TEXT NOT NULL,\n  body TEXT NOT NULL,\n  status TEXT NOT NULL DEFAULT 'sent',\n  template_key TEXT,\n  provider_id TEXT,\n  author TEXT NOT NULL DEFAULT 'human',\n  created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS followups (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  lead_id INTEGER NOT NULL REFERENCES leads(id) ON DELETE CASCADE,\n  step INTEGER NOT NULL,\n  due_at TEXT NOT NULL,\n  status TEXT NOT NULL DEFAULT 'pending',\n  template TEXT NOT NULL,\n  sent_at TEXT\n);\nCREATE TABLE IF NOT EXISTS orders (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  lead_id INTEGER NOT NULL REFERENCES leads(id) ON DELETE CASCADE,\n  code TEXT NOT NULL,\n  description TEXT NOT NULL,\n  total REAL NOT NULL,\n  status TEXT NOT NULL,\n  carrier TEXT,\n  tracking TEXT,\n  cashback REAL NOT NULL DEFAULT 0,\n  cashback_status TEXT NOT NULL DEFAULT 'none',\n  created_at TEXT NOT NULL,\n  delivered_at TEXT\n);\nCREATE TABLE IF NOT EXISTS broadcasts (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT NOT NULL,\n  vertical TEXT,\n  stage_filter TEXT,\n  template TEXT NOT NULL,\n  total INTEGER NOT NULL DEFAULT 0,\n  sent INTEGER NOT NULL DEFAULT 0,\n  status TEXT NOT NULL DEFAULT 'queued',\n  created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS events (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  lead_id INTEGER,\n  type TEXT NOT NULL,\n  detail TEXT NOT NULL,\n  created_at TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS settings (\n  key TEXT PRIMARY KEY,\n  value TEXT NOT NULL\n);\nCREATE TABLE IF NOT EXISTS payments (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  code TEXT NOT NULL UNIQUE,\n  lead_id INTEGER NOT NULL REFERENCES leads(id) ON DELETE CASCADE,\n  order_id INTEGER,\n  provider TEXT NOT NULL,\n  method TEXT NOT NULL,\n  amount REAL NOT NULL,\n  status TEXT NOT NULL DEFAULT 'pending',\n  external_id TEXT,\n  pix_code TEXT,\n  checkout_url TEXT,\n  description TEXT NOT NULL,\n  created_at TEXT NOT NULL,\n  paid_at TEXT\n);\nCREATE INDEX IF NOT EXISTS idx_payments_code ON payments(code);\nCREATE INDEX IF NOT EXISTS idx_payments_status ON payments(status);\nCREATE INDEX IF NOT EXISTS idx_leads_vertical ON leads(vertical);\nCREATE INDEX IF NOT EXISTS idx_messages_lead ON messages(lead_id);\nCREATE INDEX IF NOT EXISTS idx_followups_due ON followups(status, due_at);"
