// Config usada pelo build/deploy remoto (GitHub Actions) via `wrangler.deploy`.
// Os arquivos wrangler.jsonc / freebuff.wrangler.jsonc são gerados pelo Freebuff
// Sites e não devem ser editados: eles apontam para freebuff-sites-build/entry.js.
{
  "name": "projeto-kraken",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freebuff-next-db-local",
      "database_id": "fac29d00-d4b0-4b6a-b602-9528bf5714a9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "freebuff-next-cache-local"
    },
    {
      "binding": "FILES",
      "bucket_name": "freebuff-next-files-local"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    {
      "tag": "kraken-v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ]
}
