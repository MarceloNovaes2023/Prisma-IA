# --- WhatsApp Cloud API (Meta) ---------------------------------
# Sem estas duas variáveis a plataforma roda em modo sandbox:
# os envios são registrados no banco, mas nada sai da máquina.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=troque-por-uma-string-secreta
WHATSAPP_APP_SECRET=
WHATSAPP_APP_ID=
WHATSAPP_DISPLAY_NUMBER=+55 11 4002-8922

# Nicho padrão quando o número recebe contato de um lead desconhecido
WHATSAPP_DEFAULT_VERTICAL=moda-varejo

# --- IA de atendimento -----------------------------------------
# Qualquer endpoint compatível com OpenAI: Z.ai, Freebuff, OpenAI, Groq.
# Sem chave, a IA roda em simulação determinística (sem custo, sem rede).
AI_API_KEY=
AI_API_BASE=https://api.z.ai/api/paas/v4
AI_MODEL=glm-4-flash

# --- Pagamentos (Mercado Pago / PIX) ---------------------------
# Sem token, o checkout roda em sandbox com BR Code local.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=
PIX_KEY=pagamentos@fluxo.demo
PIX_MERCHANT_NAME=FLUXO PAGAMENTOS
PIX_MERCHANT_CITY=SAO PAULO

# --- Automação -------------------------------------------------
# Protege /api/cron/cadences (Authorization: Bearer <valor>)
CRON_SECRET=

# Protege POST /api/leads (header x-api-key)
INTAKE_API_KEY=

# --- Banco -----------------------------------------------------
# Padrão: ./data/fluxo.db (SQLite via node:sqlite)
FLUXO_DB=

# --- Radar · fontes de anúncios ---------------------------------
# Meta Ad Library (anúncio comercial: cobertura UE + Reino Unido).
# Token sai do app em developers.facebook.com → Ad Library API.
META_AD_LIBRARY_TOKEN=
META_AD_LIBRARY_COUNTRIES=PT,IE,ES,DE,FR
# Opcional: versão da Graph API (padrão v26.0)
META_API_VERSION=
# Opcional: tentativas por requisição em caso de throttling (padrão 3)
META_RETRY_ATTEMPTS=

# TikTok Commercial Content API (exige pesquisa aprovada)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Microsoft Ad Library (cobertura EEA). Não pede token: entra sozinha no ciclo
# automático. Desligue com RADAR_BING_ENABLED=off; páginas por execução (padrão 2).
RADAR_BING_ENABLED=on
RADAR_BING_PAGES=

# --- Radar · leitura por IA da coleta --------------------------
# A cada sincronização com anúncio novo, a IA resume o que entrou.
# Sem chave, ou com RADAR_INSIGHTS=off, a leitura fica local/marcada como simulação.
RADAR_INSIGHTS=on
# Quantos anúncios entram no contexto do modelo (padrão 6, máximo 12)
RADAR_INSIGHTS_ADS=

# Protege /api/radar/sync, /api/radar/ads, /api/radar/lead e /api/radar/brief
RADAR_API_KEY=

# --- Radar · aviso de fonte fora do ar/recuperada ------------------
# Destinos padrão do painel Radar › Alertas (o formulário pode sobrescrever).
# Preenchidos, são avisados automaticamente a cada sincronização em que a fonte
# cai ou volta — sem clicar no painel.
RADAR_ALERT_WHATSAPP=
RADAR_ALERT_EMAIL=
# Entrega automática dos avisos (padrão: ligada). Desligue com RADAR_ALERTS_AUTO=off.
RADAR_ALERTS_AUTO=on
# Aviso quando a taxa de falha de uma fonte passa do limite no período.
# Percentual (padrão 25), tamanho da janela em execuções recentes (padrão 10)
# e amostra mínima para a conta valer (padrão 4). Limite 0 desliga o aviso.
RADAR_ERROR_RATE_THRESHOLD=25
RADAR_ERROR_RATE_WINDOW=10
RADAR_ERROR_RATE_MIN_RUNS=4
# E-mail transacional (Resend). Sem a chave, o botão de e-mail fica bloqueado.
RESEND_API_KEY=
# Remetente verificado na Resend (ex.: Radar <alertas@seudominio.com>).
RADAR_ALERT_FROM=

# Agendador interno: roda as fontes configuradas em intervalo fixo.
# Desligue com RADAR_SYNC_ENABLED=false.
RADAR_SYNC_ENABLED=true
RADAR_SYNC_INTERVAL_MINUTES=360
# Validade da trava de sincronização no banco (lease entre instâncias).
RADAR_SYNC_LOCK_TTL_MINUTES=15
# Só para teste local rápido (segundos); em produção use minutos.
RADAR_SYNC_INTERVAL_SECONDS=
